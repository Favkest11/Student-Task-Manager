# Copy this file to .env and adjust the values.

# Port the API listens on.
PORT=3001

# Where the SQLite database file is stored (relative to the server folder).
DATABASE_PATH=./data/app.db

# Comma-separated list of frontend origins allowed to call the API from the browser.
# Not needed in local development (Vite proxies /api to this server).
# Example for production: CORS_ORIGIN=https://crudstudenttaskmanager.netlify.app
CORS_ORIGIN=

# Set to 1 when the server runs behind a reverse proxy (Render, Railway, nginx...)
# so that the login rate limit sees the real client IP.
TRUST_PROXY=
